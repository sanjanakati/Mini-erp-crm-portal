# Database connection string
# Local docker-compose default (see docker-compose.yml at repo root):
DATABASE_URL="postgresql://erp_user:erp_password@localhost:5432/mini_erp_crm?schema=public"

# JWT
JWT_SECRET="change-this-to-a-long-random-string-in-production"
JWT_EXPIRES_IN="8h"

# Server
PORT=4000
NODE_ENV=development

# CORS - comma separated list of allowed origins
CORS_ORIGIN="http://localhost:5173"
